<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ImpactSE.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Impact SE">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: profile being edited, status and save -->
        <Grid Padding="24,16,24,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Impact SE" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <ComboBox x:Name="ProfileBox" Grid.Column="1" Header="Profile" MinWidth="170"
                      SelectionChanged="ProfileBox_SelectionChanged" IsEnabled="False" />
            <TextBlock x:Name="StatusText" Grid.Column="2" VerticalAlignment="Bottom" Margin="8,0,0,6"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <Button x:Name="DiscardButton" Grid.Column="3" Content="Discard changes" VerticalAlignment="Bottom"
                    Click="Discard_Click" IsEnabled="False" />
            <Button x:Name="SaveButton" Grid.Column="4" Content="Save to mouse" VerticalAlignment="Bottom"
                    Style="{StaticResource AccentButtonStyle}" Click="Save_Click" IsEnabled="False" />
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" SelectionChanged="Nav_SelectionChanged" IsEnabled="False">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Buttons" Tag="Buttons" Icon="Keyboard" />
                <NavigationViewItem Content="DPI" Tag="Dpi" Icon="Target" />
                <NavigationViewItem Content="Lighting" Tag="Lighting" Icon="FontColor" />
                <NavigationViewItem Content="Profiles &amp; polling" Tag="Performance" Icon="Sync" />
                <NavigationViewItem Content="Backups" Tag="Backups" Icon="Save" />
            </NavigationView.MenuItems>

            <ScrollViewer>
                <Grid Padding="32,24,32,32" MaxWidth="900" HorizontalAlignment="Left">

                    <!-- Buttons -->
                    <StackPanel x:Name="ButtonsPanel" Spacing="16">
                        <TextBlock Text="Side buttons" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Pick a key or action for each of the 12 side buttons. F13–F24 are real keys that no keyboard has, so they never clash with your number row and games can bind them cleanly." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="PresetBox" PlaceholderText="Choose a preset" MinWidth="240" />
                            <Button Content="Apply preset" Click="ApplyPreset_Click" />
                        </StackPanel>
                        <Grid x:Name="SideGrid" ColumnSpacing="12" RowSpacing="12" />
                        <TextBlock Text="Top buttons and wheel" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Numbered the same way as Redragon's picture of the mouse. One button must stay on Left click, so the mouse can always click." />
                        <Grid x:Name="MainGrid" ColumnSpacing="12" RowSpacing="12" />
                    </StackPanel>

                    <!-- DPI -->
                    <StackPanel x:Name="DpiPanel" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="DPI stages" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="The DPI button on the mouse cycles through the stages that are switched on. Drag a slider or type a number: 200 to 10,000 DPI, in steps of 100." />
                        <StackPanel x:Name="DpiRows" Spacing="12" />
                    </StackPanel>

                    <!-- Lighting -->
                    <StackPanel x:Name="LightingPanel" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Lighting color" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Sets this profile's lighting color. Effects and brightness come in a later version." />
                        <ColorPicker x:Name="ColorWheel" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                     ColorChanged="ColorPicker_ColorChanged" HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- Performance -->
                    <StackPanel x:Name="PerformancePanel" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Ready-made profiles" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Fill the profile you're editing with Redragon's factory settings or a ready-made setup. It sets the buttons, DPI and polling rate (and the light color for factory profiles). Your other profiles aren't touched, and nothing changes on the mouse until you click Save to mouse." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="ProfilePresetBox" PlaceholderText="Choose a ready-made profile" MinWidth="280"
                                      SelectionChanged="ProfilePresetBox_SelectionChanged" />
                            <Button x:Name="ApplyProfilePresetButton" Content="Load into this profile"
                                    Click="ApplyProfilePreset_Click" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock x:Name="ProfilePresetText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="Reset this profile to factory settings" Click="FactoryReset_Click" />
                        <TextBlock Text="Polling rate" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
                        <RadioButtons x:Name="PollRateButtons" SelectionChanged="PollRate_SelectionChanged">
                            <x:String>1000 Hz</x:String>
                            <x:String>500 Hz</x:String>
                            <x:String>250 Hz</x:String>
                            <x:String>125 Hz</x:String>
                        </RadioButtons>
                        <TextBlock Text="Active profile" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
                        <TextBlock x:Name="ActiveProfileText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="Use this profile on the mouse" Click="MakeActive_Click" />
                    </StackPanel>

                    <!-- Backups -->
                    <StackPanel x:Name="BackupsPanel" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Backups" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="A full copy of the mouse's settings is saved every time this app connects. The oldest one is your mouse exactly as it was before this app changed anything." />
                        <TextBlock x:Name="BackupsText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Restore original settings" Click="RestoreOriginal_Click" />
                            <Button Content="Open backups folder" Click="OpenBackups_Click" />
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </NavigationView>

        <InfoBar x:Name="Banner" Grid.Row="1" VerticalAlignment="Bottom" Margin="24" IsClosable="True" />
    </Grid>
</Window>
